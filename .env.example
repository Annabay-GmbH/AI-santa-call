OPENAI_API_KEY=
# Set to true only after ZDR is enabled and verified for every API service used,
# and after completing the child-safety and privacy launch review in README.md.
CHILD_SAFETY_REVIEWED=false
OPENAI_CHAT_MODEL=gpt-6-astra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Confirm this image model is included in your ZDR and child-safety review.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
PORT=3000
# Use an absolute path to a protected, persistent, operator-monitored JSONL file.
SAFETY_EVENTS_FILE=
OPENAI_SAFETY_MODEL=gpt-6-astra

# Optional: absolute path to FFmpeg for browsers that record Ogg audio.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional opt-in illustrated-gift archive (never a transcript). Configure both.
# Use an absolute private directory and a separate mode-0600 key file containing
# a base64-encoded, cryptographically random 32-byte key. Never commit the key.
GIFT_ARCHIVE_DIR=
GIFT_ARCHIVE_KEY_FILE=
# Alternatively use GIFT_ARCHIVE_KEY from a secret manager, not both.
